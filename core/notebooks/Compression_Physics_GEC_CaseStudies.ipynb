# Compression_Physics_GEC_CaseStudies.ipynb
# ========================================
# Supplementary Notebook for "Compression Physics: Establishing a Generalized Efficiency Coefficient (GEC)"
#
# This notebook reproduces all worked case studies from the paper.

import math
import pandas as pd

def compute_gec(Y, T, S, H, D, R, E, C_max):
    """
    Compute Generalized Efficiency Coefficient (GEC).
    """
    C = Y / T
    lambda_val = (S * H * D) / (1.0 + R + E)
    C_total = lambda_val * C
    C_n = C_total / C_max if C_max > 0 else float('nan')
    return {
        "C": C,
        "lambda_val": lambda_val,
        "C_total": C_total,
        "C_n": C_n
    }

# --- Case studies ---

examples = [
    {
        "Domain": "Information (Summarization)",
        "Y": 50.0, "T": 600.0,
        "S": 0.95, "H": 0.90, "D": 1.20, "R": 0.10, "E": 0.10,
        "C_max": 1.0
    },
    {
        "Domain": "Energy (Oil Refining)",
        "Y": 20.0, "T": 42.0,
        "S": 0.98, "H": 0.85, "D": 1.50, "R": 0.05, "E": 0.10,
        "C_max": 31.0/42.0  # empirical maximum yield
    },
    {
        "Domain": "Healthcare (Throughput)",
        "Y": 80.0, "T": 1000.0,
        "S": 0.90, "H": 0.80, "D": 1.00, "R": 0.20, "E": 0.10,
        "C_max": 1.0
    },
    {
        "Domain": "AI (Training Efficiency)",
        "Y": 0.05, "T": 1.0,  # measured in kGPU-hours
        "S": 0.85, "H": 0.90, "D": 2.20, "R": 0.30, "E": 0.20,
        "C_max": 0.10  # empirical ceiling (10 points per kGPU-hour)
    },
    {
        "Domain": "Finance (ROI Normalization)",
        "Y": 0.20, "T": 1.0,  # profit per capital-year
        "S": 0.90, "H": 0.85, "D": 1.80, "R": 0.25, "E": 0.30,
        "C_max": 0.50
    }
]

# Run all examples
results = []
for ex in examples:
    out = compute_gec(ex["Y"], ex["T"], ex["S"], ex["H"], ex["D"], ex["R"], ex["E"], ex["C_max"])
    row = {**ex, **out}
    results.append(row)

df = pd.DataFrame(results)

# Display results
df[["Domain","Y","T","C","S","H","D","R","E","lambda_val","C_total","C_max","C_n"]].round(6)